# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Backend: base de datos (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/trendly
DB_USERNAME=trendly
DB_PASSWORD=

# --- Backend: seguridad ---
# Genera uno con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
# Orígenes del frontend permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Backend: correo (SMTP) para alertas ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Frontend (va en frontend/.env; Vite solo lee variables con prefijo VITE_) ---
VITE_API_URL=http://localhost:8080/api/v1
