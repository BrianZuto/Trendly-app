# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Backend: base de datos (MySQL 8) ---
# docker-compose.yml usa DB_USERNAME, DB_PASSWORD, DB_ROOT_PASSWORD y DB_PORT para crear el contenedor
DB_URL=jdbc:mysql://localhost:3306/trendly?connectionTimeZone=UTC
DB_USERNAME=trendly
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306

# --- Backend: seguridad ---
# Genera uno con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
# Orígenes del frontend permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Backend: scraping (SCRUM-41) ---
# AliExpress necesita Chrome instalado (Selenium headless). Ponlo en false si el servidor no tiene Chrome.
SCRAPING_SELENIUM=true

# --- Backend: correo (SMTP) para alertas (SCRUM-48) --- Clave SMTP de Brevo. Sin SMTP_FROM no se envían correos.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Base de los enlaces "Ver en Trendly" del correo
FRONTEND_URL=http://localhost:5173

# --- Frontend (va en frontend/.env; Vite solo lee variables con prefijo VITE_) ---
VITE_API_URL=http://localhost:8080/api/v1

# --- Backend: MercadoLibre (SCRUM-40) --- App de developers.mercadolibre.com.co (App ID y Secret Key)
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- Backend: job de recolección (SCRUM-39) --- La misma clave va en la Azure Function. Genera una con:
# openssl rand -hex 32
RECOLECCION_API_KEY=
# En desarrollo, true para correr el ciclo con @Scheduled sin Azure
TRENDLY_SCHEDULER_LOCAL=false
