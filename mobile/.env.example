# Copia este archivo como mobile/.env. Expo solo pasa a la app las variables con prefijo EXPO_PUBLIC_.
# Sin este archivo la app usa el backend desplegado en Azure.
# Para un backend local, usa la IP del computador en la red wifi (el celular no entiende "localhost"):
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api/v1
