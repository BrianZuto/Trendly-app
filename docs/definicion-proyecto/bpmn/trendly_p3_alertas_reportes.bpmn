<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_trendly_p3_alertas_reportes" targetNamespace="http://trendly.co/bpmn">
<bpmn:collaboration id="Collab_trendly_p3_alertas_reportes"><bpmn:participant id="Pool_trendly_p3_alertas_reportes" name="Proceso 3 · Alertas, reportes y toma de decisiones" processRef="Process_trendly_p3_alertas_reportes"/></bpmn:collaboration>
<bpmn:process id="Process_trendly_p3_alertas_reportes" isExecutable="false"><bpmn:laneSet id="LaneSet_trendly_p3_alertas_reportes">
<bpmn:lane id="Lane_trendly_p3_alertas_reportes_0" name="Servicio de notificaciones">
<bpmn:flowNodeRef>s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p3_alertas_reportes_1" name="Base de datos (MySQL)">
<bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p3_alertas_reportes_2" name="Vendedor">
<bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p3_alertas_reportes_3" name="Generador de reportes">
<bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Sugerencia generada (Proceso 2)">
<bpmn:outgoing>f_s_t1</bpmn:outgoing>
<bpmn:messageEventDefinition id="Msg_s"/>
</bpmn:startEvent>
<bpmn:serviceTask id="t1" name="Comparar con el último precio y el umbral del vendedor">
<bpmn:incoming>f_s_t1</bpmn:incoming>
<bpmn:outgoing>f_t1_g1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="g1" name="¿Supera umbral o cambió stock?">
<bpmn:incoming>f_t1_g1</bpmn:incoming>
<bpmn:outgoing>f_g1_e1</bpmn:outgoing>
<bpmn:outgoing>f_g1_t2</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="e1" name="Tablero actualizado sin alerta">
<bpmn:incoming>f_g1_e1</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="t2" name="Registrar y clasificar la alerta">
<bpmn:incoming>f_g1_t2</bpmn:incoming>
<bpmn:outgoing>f_t2_t3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="t3" name="Enviar alerta por correo y push">
<bpmn:incoming>f_t2_t3</bpmn:incoming>
<bpmn:outgoing>f_t3_t4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="t4" name="Revisar alerta y decidir: aceptar, ajustar o descartar">
<bpmn:incoming>f_t3_t4</bpmn:incoming>
<bpmn:outgoing>f_t4_t5</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="t5" name="Registrar decisión y actualizar precio del producto">
<bpmn:incoming>f_t4_t5</bpmn:incoming>
<bpmn:outgoing>f_t5_g2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="g2" name="¿Solicita reporte?">
<bpmn:incoming>f_t5_g2</bpmn:incoming>
<bpmn:outgoing>f_g2_e2</bpmn:outgoing>
<bpmn:outgoing>f_g2_t6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="e2" name="Decisión registrada">
<bpmn:incoming>f_g2_e2</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="t6" name="Generar reporte Excel / PDF">
<bpmn:incoming>f_g2_t6</bpmn:incoming>
<bpmn:outgoing>f_t6_e3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="e3" name="Reporte descargado">
<bpmn:incoming>f_t6_e3</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="f_s_t1" name="" sourceRef="s" targetRef="t1"/>
<bpmn:sequenceFlow id="f_t1_g1" name="" sourceRef="t1" targetRef="g1"/>
<bpmn:sequenceFlow id="f_g1_e1" name="No" sourceRef="g1" targetRef="e1"/>
<bpmn:sequenceFlow id="f_g1_t2" name="Sí" sourceRef="g1" targetRef="t2"/>
<bpmn:sequenceFlow id="f_t2_t3" name="" sourceRef="t2" targetRef="t3"/>
<bpmn:sequenceFlow id="f_t3_t4" name="" sourceRef="t3" targetRef="t4"/>
<bpmn:sequenceFlow id="f_t4_t5" name="" sourceRef="t4" targetRef="t5"/>
<bpmn:sequenceFlow id="f_t5_g2" name="" sourceRef="t5" targetRef="g2"/>
<bpmn:sequenceFlow id="f_g2_e2" name="No" sourceRef="g2" targetRef="e2"/>
<bpmn:sequenceFlow id="f_g2_t6" name="Sí" sourceRef="g2" targetRef="t6"/>
<bpmn:sequenceFlow id="f_t6_e3" name="" sourceRef="t6" targetRef="e3"/>
</bpmn:process>
