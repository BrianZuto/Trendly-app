<bpmn:sequenceFlow id="f_crear_pu" name="" sourceRef="crear" targetRef="pu"/>
<bpmn:sequenceFlow id="f_pu_jwt" name="" sourceRef="pu" targetRef="jwt"/>
<bpmn:sequenceFlow id="f_jwt_prod" name="" sourceRef="jwt" targetRef="prod"/>
<bpmn:sequenceFlow id="f_prod_gfmt" name="" sourceRef="prod" targetRef="gfmt"/>
<bpmn:sequenceFlow id="f_gfmt_err" name="No" sourceRef="gfmt" targetRef="err"/>
<bpmn:sequenceFlow id="f_err_prod" name="" sourceRef="err" targetRef="prod"/>
<bpmn:sequenceFlow id="f_gfmt_pp" name="Sí" sourceRef="gfmt" targetRef="pp"/>
<bpmn:sequenceFlow id="f_pp_e" name="" sourceRef="pp" targetRef="e"/>
</bpmn:process>
