<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_trendly_p1_registro" targetNamespace="http://trendly.co/bpmn">
<bpmn:collaboration id="Collab_trendly_p1_registro"><bpmn:participant id="Pool_trendly_p1_registro" name="Proceso 1 · Registro de usuarios y productos a monitorear" processRef="Process_trendly_p1_registro"/></bpmn:collaboration>
<bpmn:process id="Process_trendly_p1_registro" isExecutable="false"><bpmn:laneSet id="LaneSet_trendly_p1_registro">
<bpmn:lane id="Lane_trendly_p1_registro_0" name="Vendedor">
<bpmn:flowNodeRef>s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>login</bpmn:flowNodeRef>
<bpmn:flowNodeRef>reg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>prod</bpmn:flowNodeRef>
<bpmn:flowNodeRef>err</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p1_registro_1" name="Sistema (API Spring Boot)">
<bpmn:flowNodeRef>gcred</bpmn:flowNodeRef>
<bpmn:flowNodeRef>email</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gemail</bpmn:flowNodeRef>
<bpmn:flowNodeRef>crear</bpmn:flowNodeRef>
<bpmn:flowNodeRef>jwt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gfmt</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p1_registro_2" name="Base de datos (MySQL)">
<bpmn:flowNodeRef>pu</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Vendedor quiere monitorear productos">
<bpmn:outgoing>f_s_g0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:exclusiveGateway id="g0" name="¿Usuario registrado?">
<bpmn:incoming>f_s_g0</bpmn:incoming>
<bpmn:outgoing>f_g0_login</bpmn:outgoing>
<bpmn:outgoing>f_g0_reg</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="login" name="Diligenciar formulario de login">
<bpmn:incoming>f_g0_login</bpmn:incoming>
<bpmn:incoming>f_gcred_login</bpmn:incoming>
<bpmn:outgoing>f_login_gcred</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="reg" name="Diligenciar formulario de registro">
<bpmn:incoming>f_g0_reg</bpmn:incoming>
<bpmn:incoming>f_gemail_reg</bpmn:incoming>
<bpmn:outgoing>f_reg_email</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gcred" name="¿Credenciales válidas?">
<bpmn:incoming>f_login_gcred</bpmn:incoming>
<bpmn:outgoing>f_gcred_login</bpmn:outgoing>
<bpmn:outgoing>f_gcred_jwt</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="email" name="Consultar email en la base de datos">
<bpmn:incoming>f_reg_email</bpmn:incoming>
<bpmn:outgoing>f_email_gemail</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="gemail" name="¿Email ya registrado?">
<bpmn:incoming>f_email_gemail</bpmn:incoming>
<bpmn:outgoing>f_gemail_reg</bpmn:outgoing>
<bpmn:outgoing>f_gemail_crear</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="crear" name="Crear usuario con contraseña cifrada">
<bpmn:incoming>f_gemail_crear</bpmn:incoming>
<bpmn:outgoing>f_crear_pu</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="pu" name="Persistir usuario">
<bpmn:incoming>f_crear_pu</bpmn:incoming>
<bpmn:outgoing>f_pu_jwt</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="jwt" name="Generar token JWT">
<bpmn:incoming>f_gcred_jwt</bpmn:incoming>
<bpmn:incoming>f_pu_jwt</bpmn:incoming>
<bpmn:outgoing>f_jwt_prod</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="prod" name="Ingresar URL o palabra clave, costo, precio y margen">
<bpmn:incoming>f_jwt_prod</bpmn:incoming>
<bpmn:incoming>f_err_prod</bpmn:incoming>
<bpmn:outgoing>f_prod_gfmt</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gfmt" name="¿Formato válido?">
<bpmn:incoming>f_prod_gfmt</bpmn:incoming>
<bpmn:outgoing>f_gfmt_err</bpmn:outgoing>
<bpmn:outgoing>f_gfmt_pp</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="err" name="Mostrar error de formato">
<bpmn:incoming>f_gfmt_err</bpmn:incoming>
<bpmn:outgoing>f_err_prod</bpmn:outgoing>
</bpmn:task>
<bpmn:serviceTask id="pp" name="Persistir producto asociado al vendedor">
<bpmn:incoming>f_gfmt_pp</bpmn:incoming>
<bpmn:outgoing>f_pp_e</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="e" name="Producto registrado (entrada del Proceso 2)">
<bpmn:incoming>f_pp_e</bpmn:incoming>
<bpmn:messageEventDefinition id="Msg_e"/>
</bpmn:endEvent>
