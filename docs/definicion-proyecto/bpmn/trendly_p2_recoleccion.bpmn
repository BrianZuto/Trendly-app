<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_trendly_p2_recoleccion" targetNamespace="http://trendly.co/bpmn">
<bpmn:collaboration id="Collab_trendly_p2_recoleccion"><bpmn:participant id="Pool_trendly_p2_recoleccion" name="Proceso 2 · Monitoreo, recolección y análisis de precios" processRef="Process_trendly_p2_recoleccion"/></bpmn:collaboration>
<bpmn:process id="Process_trendly_p2_recoleccion" isExecutable="false"><bpmn:laneSet id="LaneSet_trendly_p2_recoleccion">
<bpmn:lane id="Lane_trendly_p2_recoleccion_0" name="Azure Functions">
<bpmn:flowNodeRef>s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>job</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p2_recoleccion_1" name="Scraper">
<bpmn:flowNodeRef>ext</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gext</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fallo</bpmn:flowNodeRef>
<bpmn:flowNodeRef>grei</bpmn:flowNodeRef>
<bpmn:flowNodeRef>marca</bpmn:flowNodeRef>
<bpmn:flowNodeRef>efallo</bpmn:flowNodeRef>
<bpmn:flowNodeRef>val</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gcons</bpmn:flowNodeRef>
<bpmn:flowNodeRef>desc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>edesc</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p2_recoleccion_2" name="Motor de análisis">
<bpmn:flowNodeRef>obt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gsuf</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pend</bpmn:flowNodeRef>
<bpmn:flowNodeRef>epend</bpmn:flowNodeRef>
<bpmn:flowNodeRef>comp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>calc</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_trendly_p2_recoleccion_3" name="Base de datos (MySQL)">
<bpmn:flowNodeRef>hist</bpmn:flowNodeRef>
<bpmn:flowNodeRef>sug</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Cada 6 horas">
<bpmn:outgoing>f_s_job</bpmn:outgoing>
<bpmn:timerEventDefinition id="Timer_s"/>
</bpmn:startEvent>
<bpmn:serviceTask id="job" name="Disparar job de scraping programado">
<bpmn:incoming>f_s_job</bpmn:incoming>
<bpmn:outgoing>f_job_ext</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ext" name="Extraer precio y disponibilidad">
<bpmn:incoming>f_job_ext</bpmn:incoming>
<bpmn:incoming>f_grei_ext</bpmn:incoming>
<bpmn:outgoing>f_ext_gext</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="gext" name="¿Extracción exitosa?">
<bpmn:incoming>f_ext_gext</bpmn:incoming>
<bpmn:outgoing>f_gext_fallo</bpmn:outgoing>
<bpmn:outgoing>f_gext_val</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="fallo" name="Registrar fallo y reintentar">
<bpmn:incoming>f_gext_fallo</bpmn:incoming>
<bpmn:outgoing>f_fallo_grei</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="grei" name="¿Reintentos agotados?">
<bpmn:incoming>f_fallo_grei</bpmn:incoming>
<bpmn:outgoing>f_grei_ext</bpmn:outgoing>
<bpmn:outgoing>f_grei_marca</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="marca" name="Marcar producto para revisión del administrador">
<bpmn:incoming>f_grei_marca</bpmn:incoming>
<bpmn:outgoing>f_marca_efallo</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="efallo" name="Fallo registrado">
<bpmn:incoming>f_marca_efallo</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="val" name="Validar precio numérico y producto disponible">
<bpmn:incoming>f_gext_val</bpmn:incoming>
<bpmn:outgoing>f_val_gcons</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="gcons" name="¿Dato consistente?">
<bpmn:incoming>f_val_gcons</bpmn:incoming>
<bpmn:outgoing>f_gcons_desc</bpmn:outgoing>
<bpmn:outgoing>f_gcons_hist</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="desc" name="Descartar dato y marcar producto para revisión">
<bpmn:incoming>f_gcons_desc</bpmn:incoming>
<bpmn:outgoing>f_desc_edesc</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="edesc" name="Dato descartado">
<bpmn:incoming>f_desc_edesc</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="hist" name="Persistir nuevo punto del histórico">
<bpmn:incoming>f_gcons_hist</bpmn:incoming>
<bpmn:outgoing>f_hist_obt</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="obt" name="Obtener histórico de precios">
<bpmn:incoming>f_hist_obt</bpmn:incoming>
<bpmn:outgoing>f_obt_gsuf</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="gsuf" name="¿Histórico suficiente para comparar?">
<bpmn:incoming>f_obt_gsuf</bpmn:incoming>
<bpmn:outgoing>f_gsuf_pend</bpmn:outgoing>
<bpmn:outgoing>f_gsuf_comp</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="pend" name="Dejar análisis pendiente">
<bpmn:incoming>f_gsuf_pend</bpmn:incoming>
<bpmn:outgoing>f_pend_epend</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="epend" name="Análisis pendiente">
<bpmn:incoming>f_pend_epend</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="comp" name="Comparar precios entre plataformas">
<bpmn:incoming>f_gsuf_comp</bpmn:incoming>
<bpmn:outgoing>f_comp_calc</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="calc" name="Calcular precio y margen sugeridos">
<bpmn:incoming>f_comp_calc</bpmn:incoming>
<bpmn:outgoing>f_calc_sug</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="sug" name="Persistir sugerencia de precio y margen">
<bpmn:incoming>f_calc_sug</bpmn:incoming>
<bpmn:outgoing>f_sug_e</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="e" name="Sugerencia generada (dispara el Proceso 3)">
<bpmn:incoming>f_sug_e</bpmn:incoming>
<bpmn:messageEventDefinition id="Msg_e"/>
</bpmn:endEvent>
<bpmn:sequenceFlow id="f_s_job" name="" sourceRef="s" targetRef="job"/>
<bpmn:sequenceFlow id="f_job_ext" name="" sourceRef="job" targetRef="ext"/>
<bpmn:sequenceFlow id="f_ext_gext" name="" sourceRef="ext" targetRef="gext"/>
