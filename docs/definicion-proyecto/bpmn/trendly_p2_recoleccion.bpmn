<bpmn:sequenceFlow id="f_grei_marca" name="Sí" sourceRef="grei" targetRef="marca"/>
<bpmn:sequenceFlow id="f_marca_efallo" name="" sourceRef="marca" targetRef="efallo"/>
<bpmn:sequenceFlow id="f_gext_val" name="Sí" sourceRef="gext" targetRef="val"/>
<bpmn:sequenceFlow id="f_val_gcons" name="" sourceRef="val" targetRef="gcons"/>
<bpmn:sequenceFlow id="f_gcons_desc" name="No" sourceRef="gcons" targetRef="desc"/>
<bpmn:sequenceFlow id="f_desc_edesc" name="" sourceRef="desc" targetRef="edesc"/>
<bpmn:sequenceFlow id="f_gcons_hist" name="Sí" sourceRef="gcons" targetRef="hist"/>
<bpmn:sequenceFlow id="f_hist_obt" name="" sourceRef="hist" targetRef="obt"/>
<bpmn:sequenceFlow id="f_obt_gsuf" name="" sourceRef="obt" targetRef="gsuf"/>
<bpmn:sequenceFlow id="f_gsuf_pend" name="No" sourceRef="gsuf" targetRef="pend"/>
<bpmn:sequenceFlow id="f_pend_epend" name="" sourceRef="pend" targetRef="epend"/>
<bpmn:sequenceFlow id="f_gsuf_comp" name="Sí" sourceRef="gsuf" targetRef="comp"/>
<bpmn:sequenceFlow id="f_comp_calc" name="" sourceRef="comp" targetRef="calc"/>
<bpmn:sequenceFlow id="f_calc_sug" name="" sourceRef="calc" targetRef="sug"/>
<bpmn:sequenceFlow id="f_sug_e" name="" sourceRef="sug" targetRef="e"/>
</bpmn:process>
